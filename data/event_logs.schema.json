{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "XESpresso — Event Log Dataset Record",
  "description": "Schema for a single event log dataset entry, built from one row of the event log table: descriptive metadata (for the Costa et al. collection as coded by its authors) plus FEEED-computed process-mining features, where computed. Hidden entries keep only the fields needed for aggregate views and their FEEED features, so that the feature space and the correlations can be recomputed in the browser, and have every identifying field set to null.",
  "type": "object",
  "required": [
    "_id",
    "event_log_id",
    "basic_info",
    "domain_context",
    "academic_context",
    "data_characteristics",
    "resource_context",
    "path_observation",
    "feeed_available"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "description": "Stable slug identifier for this record"
    },
    "hidden": {
      "type": "boolean",
      "description": "True for entries outside the public sample: counted in aggregates and plots, not listed"
    },
    "event_log_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Stable numeric ID (Costa et al.'s Event Log ID for their logs); null when hidden"
    },
    "basic_info": {
      "type": "object",
      "title": "Basic Process Analytics",
      "properties": {
        "event_log_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_log_dataset_file_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_log_year": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Year the event log dataset was created/released"
        },
        "dataset_size": {
          "type": [
            "string",
            "null"
          ]
        },
        "dataset_format": {
          "type": [
            "string",
            "null"
          ]
        },
        "number_of_cases": {
          "type": [
            "integer",
            "null"
          ]
        },
        "number_of_variants": {
          "type": [
            "integer",
            "null"
          ]
        },
        "number_of_unique_variants": {
          "type": [
            "integer",
            "null"
          ]
        },
        "number_of_events": {
          "type": [
            "integer",
            "null"
          ]
        },
        "number_of_activities": {
          "type": [
            "integer",
            "null"
          ]
        },
        "number_of_additional_attributes": {
          "type": [
            "integer",
            "null"
          ]
        },
        "additional_attributes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "resource_availability": {
          "type": "boolean"
        },
        "median_case_duration": {
          "type": [
            "string",
            "null"
          ]
        },
        "mean_case_duration": {
          "type": [
            "string",
            "null"
          ]
        },
        "start_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "end_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "domain_context": {
      "type": "object",
      "title": "Domain Context",
      "properties": {
        "domain_application": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Administrative Process",
            "Administrative Process for Healthcare",
            "Banking",
            "Financial",
            "Healthcare",
            "IT Service Management",
            "Law",
            "Manufacturing",
            "Operational Process",
            "Process Mining Benchmark",
            "Public Administration",
            "Sales",
            "Software",
            null
          ],
          "description": "Primary color-by / grouping field across the app"
        },
        "event_log_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "IoT Lab Logs",
            "Real-life",
            "Synthetic",
            null
          ]
        },
        "process_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Main Process",
            "Sub Process",
            null
          ]
        },
        "process_information": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "academic_context": {
      "type": "object",
      "title": "Academic Context",
      "properties": {
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "year": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Academic Context Year: publication year of the referencing paper, or of the dataset for logs without one (drives the app's time axis)"
        },
        "publication_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Conference Paper",
            "Journal Article",
            "Workshop",
            null
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
